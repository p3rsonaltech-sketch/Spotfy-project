<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#121212">
<title>SPOTFY PAY — by João Xavier 66062</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--bg:#121212;--card:#181818;--card2:#282828;--green:#1ed760;--green2:#00ff88;--white:#fff;--muted:#b3b3b3;--red:#ff4444;--yellow:#ffaa00}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top right,#0b2b19 0,#121212 35%,#090909 100%);color:var(--white);font-family:Inter,Arial,sans-serif;min-height:100vh}button,input,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.wrap{width:min(1180px,94%);margin:auto}.card{background:rgba(24,24,24,.96);border:1px solid #303030;border-radius:12px;box-shadow:0 12px 35px #0009}.pad{padding:24px}
.login{min-height:100vh;display:grid;place-items:center;padding:20px}.loginbox{width:min(440px,100%)}.logo{text-align:center;font-size:39px;font-weight:800;letter-spacing:-2px}.logo span,.brand span{color:var(--green)}.sub{text-align:center;color:var(--muted);margin:5px 0 25px}.switch{display:grid;grid-template-columns:1fr 1fr;background:#0d0d0d;border-radius:10px;padding:4px;margin-bottom:18px}.switch button{background:none;border:0;color:#aaa;padding:11px;border-radius:8px}.switch button.active{background:var(--green);color:#000;font-weight:800}.field{margin:12px 0}.field label{display:block;color:var(--muted);font-size:12px;margin-bottom:7px}.field input,.field textarea{width:100%;background:#101010;color:#fff;border:1px solid #3b3b3b;border-radius:8px;padding:13px;outline:0}.field input:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px #1ed76018}.primary{width:100%;background:var(--green);color:#000;border:0;padding:14px;border-radius:999px;font-weight:800;box-shadow:0 0 24px #1ed76035}.primary:hover{filter:brightness(1.08)}.ghost{background:#292929;color:#fff;border:0;padding:9px 13px;border-radius:999px}.danger{background:#4a1515;color:#ff9999}.footer{text-align:center;color:#666;font-size:11px;margin-top:18px}
header{position:sticky;top:0;z-index:5;background:#101010ed;border-bottom:1px solid #2b2b2b;backdrop-filter:blur(12px)}.head{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:15px}.brand{font-weight:800;font-size:23px;letter-spacing:-1px}.identity{color:var(--muted);font-size:12px;margin-right:8px}main{padding:26px 0 40px}.hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:20px}.hero h1{margin:0;font-size:28px}.muted{color:var(--muted);font-size:12px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.stat{padding:18px}.stat b{display:block;font-size:25px;margin-top:6px}.price{font-size:38px;font-weight:800;margin:10px 0}.pix{display:flex;align-items:center;gap:10px;background:#0d0d0d;border:1px dashed #444;padding:12px;border-radius:8px;margin-top:14px}.pix code{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.upload{border:2px dashed #444;border-radius:10px;padding:23px;text-align:center;margin-top:15px}.upload input{display:none}.upload label{display:inline-block;background:#292929;padding:10px 16px;border-radius:999px}.preview{display:block;max-width:100%;max-height:280px;margin:14px auto 0;border-radius:8px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}.tabs button{background:#252525;color:#bbb;border:0;padding:10px 14px;border-radius:999px}.tabs button.active{background:var(--green);color:#000;font-weight:800}.row{display:flex;justify-content:space-between;align-items:center;gap:12px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.actions{display:flex;gap:6px;flex-wrap:wrap}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:12px 8px;border-bottom:1px solid #2b2b2b;white-space:nowrap}th{color:#888}.status{display:inline-block;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:800}.Pendente{background:#493605;color:#ffd36a}.Aprovado{background:#073b23;color:#61ffad}.Recusado{background:#4b1111;color:#ff7777}.empty{text-align:center;color:#777;padding:30px}.toast{position:fixed;right:18px;bottom:18px;z-index:30;background:#222;padding:14px 18px;border-radius:9px;border-left:4px solid var(--green);box-shadow:0 8px 30px #000}.modal{position:fixed;inset:0;background:#000d;z-index:20;display:grid;place-items:center;padding:20px}.modalbox{width:min(900px,100%);max-height:90vh;overflow:auto}.modal img,.modal iframe{width:100%;max-height:70vh;border:0;border-radius:8px}
@media(max-width:760px){.grid,.two{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.hero{align-items:flex-start;flex-direction:column}.identity{display:none}.brand{font-size:20px}}
</style>
</head>
<body>

<div id="loginScreen" class="login">
  <div class="loginbox card pad">
    <div class="logo">SPOTFY <span>PAY</span></div>
    <div class="sub">Gestão inteligente de pagamentos</div>
    <div class="switch">
      <button id="clientMode" class="active" onclick="setMode('client')">Área do Cliente</button>
      <button id="adminMode" onclick="setMode('admin')">Painel Admin</button>
    </div>
    <div class="field"><label>E-mail</label><input id="email" type="email" autocomplete="username" placeholder="seu@email.com"></div>
    <div class="field"><label>Senha</label><input id="password" type="password" autocomplete="current-password" placeholder="••••••••" onkeydown="if(event.key==='Enter')login()"></div>
    <button class="primary" onclick="login()">ENTRAR</button>
    <div id="loginMsg" class="muted" style="text-align:center;margin-top:12px"></div>
    <div class="footer">by João Xavier 66062</div>
  </div>
</div>

<div id="app" class="hidden">
<header><div class="wrap head"><div class="brand">SPOTFY <span>PAY</span></div><div><span id="identity" class="identity"></span><button class="ghost" onclick="logout()">Sair</button></div></div></header>
<main class="wrap">

<section id="clientPanel" class="hidden">
  <div class="hero"><div><h1>Olá, <span id="clientName"></span> 👋</h1><div class="muted">Acompanhe seu plano e seus comprovantes.</div></div></div>
  <div class="grid">
    <div class="card pad">
      <div class="muted">PLANO ATIVO</div><h2 id="planName">—</h2><div id="planPrice" class="price">R$ 0,00</div>
      <div class="muted">Pagamento via PIX</div>
      <div class="pix"><code id="pixKey">Não configurada</code><button class="ghost" onclick="copyPix()">Copiar</button></div>
    </div>
    <div class="card pad">
      <h2>Enviar comprovante</h2><div class="muted">PNG, JPG ou PDF • máximo 8 MB</div>
      <div class="upload"><input id="proof" type="file" accept=".png,.jpg,.jpeg,.pdf" onchange="previewFile()"><label for="proof">📎 Selecionar comprovante</label><div id="fileName" class="muted" style="margin-top:10px"></div><div id="preview"></div></div>
      <button class="primary" style="margin-top:12px" onclick="sendProof()">ENVIAR COMPROVANTE</button>
    </div>
  </div>
  <div class="card pad" style="margin-top:16px"><h2>Meu histórico</h2><div id="clientHistory"></div></div>
</section>

<section id="adminPanel" class="hidden">
  <div class="hero"><div><h1>Painel Administrativo</h1><div class="muted">Controle do SPOTFY PAY</div></div></div>
  <div class="stats">
    <div class="card stat"><div class="muted">PENDENTES</div><b id="sPending">0</b></div>
    <div class="card stat"><div class="muted">APROVADOS</div><b id="sApproved">0</b></div>
    <div class="card stat"><div class="muted">RECEITA</div><b id="sRevenue">R$ 0,00</b></div>
    <div class="card stat"><div class="muted">CLIENTES</div><b id="sClients">0</b></div>
  </div>
  <div class="tabs">
    <button class="active" onclick="adminTab('payments',this)">🧾 Comprovantes</button>
    <button onclick="adminTab('clients',this)">👥 Clientes</button>
    <button onclick="adminTab('settings',this)">⚙️ Configurações</button>
  </div>
  <div id="adminPayments" class="card pad"></div>
  <div id="adminClients" class="card pad hidden"></div>
  <div id="adminSettings" class="card pad hidden"></div>
</section>

</main>
<div class="footer wrap" style="padding-bottom:25px">SPOTFY PAY • by João Xavier 66062</div>
</div>

<div id="modal" class="modal hidden" onclick="if(event.target===this)closeModal()">
  <div class="modalbox card pad"><div class="row"><h2>Comprovante</h2><button class="ghost" onclick="closeModal()">Fechar</button></div><div id="modalContent"></div></div>
</div>

<script>
const SUPABASE_URL='https://zfubayucdwlqzdojqufx.supabase.co';
const SUPABASE_KEY='sb_publishable_JsY4iN_lv2IIuSWbpYVuew_T2KG5eQu';
const supabase=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let mode='client', me=null, settings=null;

const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function toast(msg,bad=false){const x=document.createElement('div');x.className='toast';x.style.borderLeftColor=bad?'#ff4444':'#1ed760';x.textContent=msg;document.body.appendChild(x);setTimeout(()=>x.remove(),3500)}
function setMode(m){mode=m;clientMode.classList.toggle('active',m==='client');adminMode.classList.toggle('active',m==='admin')}
async function login(){
  loginMsg.textContent='Entrando...';
  const {data,error}=await supabase.auth.signInWithPassword({email:email.value.trim(),password:password.value});
  if(error){loginMsg.textContent='E-mail ou senha inválidos.';return}
  await startApp(data.user);
}
async function startApp(user){
  const {data:p,error}=await supabase.from('profiles').select('*').eq('id',user.id).single();
  if(error||!p||!p.active){await supabase.auth.signOut();loginMsg.textContent='Usuário sem acesso.';return}
  me=p;
  if(mode==='admin'&&p.role!=='admin'){toast('Esta conta não é administradora',true);await supabase.auth.signOut();return}
  if(mode==='client'&&p.role!=='client'){toast('Selecione Painel Admin para esta conta',true);await supabase.auth.signOut();return}
  loginScreen.classList.add('hidden');app.classList.remove('hidden');identity.textContent=p.name;
  if(p.role==='admin'){adminPanel.classList.remove('hidden');await loadAdmin()}else{clientPanel.classList.remove('hidden');clientName.textContent=p.name;await loadClient()}
}
async function logout(){await supabase.auth.signOut();location.reload()}
async function getSettings(){const {data,error}=await supabase.from('settings').select('*').eq('id',1).single();if(error)throw error;settings=data;return data}
async function loadClient(){
 try{
  const s=await getSettings();planName.textContent=s.plan_name;planPrice.textContent=money(s.price);pixKey.textContent=s.pix_key||'Não configurada';
  const {data,error}=await supabase.from('payments').select('*').eq('client_id',me.id).order('submitted_at',{ascending:false});if(error)throw error;
  clientHistory.innerHTML=data?.length?`<div class="scroll"><table><thead><tr><th>Data</th><th>Valor</th><th>Status</th><th>Comprovante</th></tr></thead><tbody>${data.map(x=>`<tr><td>${new Date(x.submitted_at).toLocaleString('pt-BR')}</td><td>${money(x.amount)}</td><td><span class="status ${x.status}">${x.status}</span></td><td>${x.proof_path?`<button class="ghost" onclick="viewProof('${x.proof_path}','${x.proof_mime||''}')">Ver</button>`:'—'}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Nenhum pagamento enviado.</div>';
 }catch(e){toast(e.message,true)}
}
async function copyPix(){try{await navigator.clipboard.writeText(pixKey.textContent);toast('PIX copiado')}catch{toast('Não foi possível copiar',true)}}
function previewFile(){
 const f=proof.files[0];if(!f)return;if(f.size>8*1024*1024){toast('Arquivo maior que 8 MB',true);proof.value='';return}
 fileName.textContent=f.name;preview.innerHTML='';
 if(f.type.startsWith('image/')){const r=new FileReader();r.onload=()=>preview.innerHTML=`<img class="preview" src="${r.result}">`;r.readAsDataURL(f)}
 else preview.innerHTML='<div class="muted" style="margin-top:10px">PDF selecionado ✓</div>';
}
async function sendProof(){
 const f=proof.files[0];if(!f){toast('Selecione um comprovante',true);return}
 try{
  if(!settings)await getSettings();
  const id=crypto.randomUUID(),ext=(f.name.split('.').pop()||'bin').toLowerCase(),path=`${me.id}/${id}.${ext}`;
  const up=await supabase.storage.from('comprovantes').upload(path,f,{contentType:f.type,upsert:false});if(up.error)throw up.error;
  const ins=await supabase.from('payments').insert({id,client_id:me.id,amount:Number(settings.price),status:'Pendente',proof_path:path,proof_name:f.name,proof_mime:f.type});
  if(ins.error){await supabase.storage.from('comprovantes').remove([path]);throw ins.error}
  proof.value='';fileName.textContent='';preview.innerHTML='';toast('Comprovante enviado com sucesso');await loadClient();
 }catch(e){toast(e.message,true)}
}
async function viewProof(path,mime){
 try{const {data,error}=await supabase.storage.from('comprovantes').createSignedUrl(path,600);if(error)throw error;modalContent.innerHTML=mime==='application/pdf'?`<iframe src="${data.signedUrl}" height="600"></iframe>`:`<img src="${data.signedUrl}">`;modal.classList.remove('hidden')}
 catch(e){toast(e.message,true)}
}
function closeModal(){modal.classList.add('hidden');modalContent.innerHTML=''}
async function loadAdmin(){
 try{
  const [pr,cl,st]=await Promise.all([supabase.from('payments').select('*').order('submitted_at',{ascending:false}),supabase.from('profiles').select('*').eq('role','client').order('created_at',{ascending:false}),getSettings()]);
  if(pr.error)throw pr.error;if(cl.error)throw cl.error;
  const payments=pr.data||[],clients=cl.data||[];const names=Object.fromEntries(clients.map(c=>[c.id,c.name]));
  sPending.textContent=payments.filter(x=>x.status==='Pendente').length;sApproved.textContent=payments.filter(x=>x.status==='Aprovado').length;sRevenue.textContent=money(payments.filter(x=>x.status==='Aprovado').reduce((a,x)=>a+Number(x.amount),0));sClients.textContent=clients.length;
  adminPayments.innerHTML=payments.length?`<div class="scroll"><table><thead><tr><th>Cliente</th><th>Data</th><th>Valor</th><th>Status</th><th>Ações</th></tr></thead><tbody>${payments.map(x=>`<tr><td>${esc(names[x.client_id]||x.client_id)}</td><td>${new Date(x.submitted_at).toLocaleString('pt-BR')}</td><td>${money(x.amount)}</td><td><span class="status ${x.status}">${x.status}</span></td><td><div class="actions">${x.proof_path?`<button class="ghost" onclick="viewProof('${x.proof_path}','${x.proof_mime||''}')">Ver</button>`:''}${x.status==='Pendente'?`<button class="ghost" onclick="review('${x.id}','Aprovado')">✓ Aprovar</button><button class="ghost danger" onclick="review('${x.id}','Recusado')">✕ Recusar</button>`:''}</div></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Nenhum comprovante.</div>';
  adminClients.innerHTML=`<div class="row"><div><h2>Clientes</h2><div class="muted">Contas individuais dos clientes.</div></div><button class="primary" style="width:auto" onclick="newClient()">+ Novo cliente</button></div><div class="scroll" style="margin-top:15px"><table><thead><tr><th>Nome</th><th>Usuário</th><th>Status</th><th>Cadastro</th></tr></thead><tbody>${clients.map(c=>`<tr><td>${esc(c.name)}</td><td>${esc(c.username||'—')}</td><td>${c.active?'Ativo':'Bloqueado'}</td><td>${new Date(c.created_at).toLocaleDateString('pt-BR')}</td></tr>`).join('')}</tbody></table></div>`;
  adminSettings.innerHTML=`<h2>Configurações de cobrança</h2><div class="two"><div class="field"><label>Nome do plano</label><input id="setPlan" value="${esc(st.plan_name)}"></div><div class="field"><label>Valor (R$)</label><input id="setPrice" type="number" step="0.01" value="${st.price}"></div></div><div class="field"><label>Chave PIX</label><input id="setPix" value="${esc(st.pix_key)}"></div><button class="primary" style="width:auto" onclick="saveSettings()">Salvar configurações</button>`;
 }catch(e){toast(e.message,true)}
}
function adminTab(t,b){[adminPayments,adminClients,adminSettings].forEach(x=>x.classList.add('hidden'));document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');({payments:adminPayments,clients:adminClients,settings:adminSettings})[t].classList.remove('hidden')}
async function review(id,status){const {error}=await supabase.from('payments').update({status,reviewed_at:new Date().toISOString(),reviewed_by:me.id}).eq('id',id);if(error)toast(error.message,true);else{toast(status==='Aprovado'?'Pagamento aprovado':'Pagamento recusado');await loadAdmin()}}
async function saveSettings(){const price=Number(setPrice.value);if(!setPlan.value.trim()||!Number.isFinite(price)||price<0){toast('Preencha os dados corretamente',true);return}const {error}=await supabase.from('settings').update({plan_name:setPlan.value.trim(),price,pix_key:setPix.value.trim(),updated_at:new Date().toISOString()}).eq('id',1);if(error)toast(error.message,true);else{toast('Configurações salvas');await loadAdmin()}}
async function newClient(){
 const name=prompt('Nome completo do cliente:');if(!name)return;const email=prompt('E-mail de login:');if(!email)return;const password=prompt('Senha inicial (mínimo 6 caracteres):');if(!password)return;const username=prompt('Usuário (opcional):')||'';
 try{const {data,error}=await supabase.functions.invoke('create-client',{body:{name,email,password,username}});if(error)throw error;if(data?.error)throw new Error(data.error);toast('Cliente criado com sucesso');await loadAdmin()}catch(e){toast(e.message||'Erro ao criar cliente',true)}
}
supabase.auth.getSession().then(({data})=>{if(data.session)startApp(data.session.user)});
supabase.auth.onAuthStateChange(()=>{});
</script>
</body>
</html>
